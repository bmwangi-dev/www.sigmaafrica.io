# Development directories
/node_modules
/.github
/.idea
/.vscode
/tests

# Storage directories (will use /tmp in production)
/storage/app/*
!/storage/app/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# Environment files
.env
.env.local
.env.development
!.env.example

# Git files
.git
.gitattributes
.gitignore

# Development tools & documentation
.phpunit.result.cache
.styleci.yml
.php_cs
.php-cs-fixer.cache
_ide_helper.php
composer.phar
docker-compose.yml
phpunit.xml
webpack.mix.js
*.log
*.md

# Large raw assets not needed in PHP function
/resources/js
/resources/css
/database/factories
/database/seeders
/database/migrations
/app/Models
/app/Console
/app/Providers/BroadcastServiceProvider.php

# Aggressive Vendor cleaning
vendor/**/tests
vendor/**/docs
vendor/**/examples
vendor/**/phpunit.*
vendor/**/*.md
vendor/**/*.txt
vendor/**/CHANGELOG*
vendor/**/CONTRIBUTING*
vendor/**/LICENSE*

# Aggressively ignore other Google Services (failsafe)
# This ignores every service folder EXCEPT Sheets
vendor/google/apiclient-services/src/Google/Service/[!S]*
vendor/google/apiclient-services/src/Google/Service/S[!h]*
vendor/google/apiclient-services/src/Google/Service/Sh[!e]*
